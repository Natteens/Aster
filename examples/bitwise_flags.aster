// Bitwise and shift operators with binary and hexadecimal literals: a small
// ability-flags program.
// Run with: aster run examples/bitwise_flags.aster

const int CAN_JUMP = 0b001;
const int CAN_RUN = 0b010;
const int CAN_ATTACK = 0b100;

public bool Has(int abilities, int flag)
{
    // `&` binds more loosely than `!=`, so the parentheses are required.
    return (abilities & flag) != 0;
}

public class Program
{
    public static int Main()
    {
        int abilities = CAN_JUMP | CAN_ATTACK;
        Log("jump=" + Has(abilities, CAN_JUMP).ToString()
            + " run=" + Has(abilities, CAN_RUN).ToString()
            + " attack=" + Has(abilities, CAN_ATTACK).ToString());

        abilities |= CAN_RUN;
        abilities &= ~CAN_JUMP;
        abilities ^= CAN_ATTACK;
        Log("after edits: " + abilities.ToString());

        // Packing and unpacking two 16-bit values in one uint.
        ushort high = 513;
        ushort low = 7;
        uint packed = ((uint)high << 16) | low;
        uint unpackedHigh = packed >> 16;
        uint unpackedLow = packed & 0xFFFFU;
        Log("packed=" + packed.ToString()
            + " high=" + unpackedHigh.ToString()
            + " low=" + unpackedLow.ToString());

        // A hexadecimal literal above int is a uint or ulong, so a bit pattern keeps its width.
        uint highBit = 0x80000000;
        Log("high bit=" + highBit.ToString() + " as int=" + ((int)highBit).ToString());

        // Arithmetic versus logical right shift on a negative value.
        int negative = -8;
        Log("arithmetic=" + (negative >> 1).ToString()
            + " logical=" + (negative >>> 1).ToString());

        // The shift count is masked to the operand width.
        Log("1 << 33 = " + (1 << 33).ToString());

        return abilities;
    }
}
