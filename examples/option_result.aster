using aster.core;

public class Bonus
{
    public int Amount;

    public Bonus(int amount)
    {
        Amount = amount;
    }
}

public int ValueOr(Option<int> option, int fallback)
{
    switch (option)
    {
        case Some(value):
            return value;
        case None:
            return fallback;
    }
}

public int Read(Result<int, string> result)
{
    switch (result)
    {
        case Ok(value):
            return value;
        case Error(message):
            Log.Error(message);
            return 0;
    }
}

public class Program
{
    public static int Main()
    {
        int? maybe = 40;
        Bonus? empty = null;
        int extra = empty?.Amount ?? 2;
        int total = ValueOr(maybe, 0) + extra;
        Result<int, string> result = Result<int, string>.Ok(total);
        return Read(result);
    }
}
