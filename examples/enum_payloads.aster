public enum Message
{
    Quit,
    Move(int x, int y),
    Write(string text),
}

public int Measure(Message message)
{
    switch (message)
    {
        case Quit:
            return 0;
        case Move(x, y):
            return x + y;
        case Write(text):
            return text.Length;
    }
}

public class Program
{
    public static int Main()
    {
        Message first = Message.Move(20, 22);
        Message second = Message.Move(20, 22);
        if (first == second)
        {
            return Measure(first);
        }

        return 0;
    }
}
