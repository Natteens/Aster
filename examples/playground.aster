
public int Choose(bool first, bool second)
{
    if (first)
    {
        return 1;
    }
    else if (second)
    {
        return 2;
    }
    else
    {
        return 3;
    }
}

public void Count()
{
    for (int index = 0; index < 10; index += 1)
    {
        if (index == 5)
        {
            break;
        }
    }
}