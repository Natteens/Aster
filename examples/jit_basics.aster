public int Add(int left, int right)
{
    return left + right;
}

public int Calculate()
{
    int total = 0;

    for (int index = 0; index < 4; index += 1)
    {
        total += Add(index, 10);
    }

    if (total == 46)
    {
        return total - 4;
    }
    else
    {
        return 0;
    }
}
