// Property access in a hot loop: every read and write goes through an accessor.

public class Particle
{
    private int x;
    private int y;

    public int X
    {
        get { return x; }
        set { x = value; }
    }

    public int Y
    {
        get { return y; }
        set { y = value; }
    }
}

public long Run()
{
    Particle particle = new Particle();
    long total = 0L;
    for (int index = 0; index < 500000; index++)
    {
        particle.X = (particle.X + particle.Y + index) % 10007;
        particle.Y = (particle.Y + 3) % 101;
        total = total + (long)particle.X;
    }
    return total;
}
