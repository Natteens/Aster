internal string MakeString()
{
    string prefix = "A";
    return prefix + "B";
}

internal int RunString(int iterations)
{
    int total = 0;
    for (int index = 0; index < iterations; index++)
    {
        string text = MakeString();
        total += text.Length;
    }
    return total;
}

public int RunSmall()
{
    return RunString(10000);
}

public int RunMedium()
{
    return RunString(100000);
}

public int RunLarge()
{
    return RunString(150000);
}
