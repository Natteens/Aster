internal int KeepObjectValue(int value)
{
    return value;
}

public class BenchmarkBox
{
    public int value;

    public BenchmarkBox(int value)
    {
        this.value = KeepObjectValue(value);
    }
}

internal int BuildTemporary()
{
    BenchmarkBox box = new BenchmarkBox(39);

    int[] values = [1];

    string prefix = "A";
    string text = prefix + "B";

    return box.value + values[0] + text.Length;
}

public int Run()
{
    int total = 0;
    for (int index = 0; index < 100000; index++)
    {
        total += BuildTemporary();
    }
    return total;
}

internal int RunMixed(int iterations)
{
    int total = 0;
    for (int index = 0; index < iterations; index++)
    {
        total += BuildTemporary();
    }
    return total;
}

public int RunSmall()
{
    return RunMixed(10000);
}

public int RunMedium()
{
    return RunMixed(100000);
}

public int RunLarge()
{
    return RunMixed(500000);
}
