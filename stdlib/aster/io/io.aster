namespace aster.io;

using aster.core;
using aster.collections;
using aster.text;

/// Portable, stable categories reported by host-managed filesystem operations.
public enum IOErrorKind
{
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    InvalidUtf8,
    NotFile,
    NotDirectory,
    LimitExceeded,
    Other,
}

/// Portable filesystem error: a stable category plus the native OS code
/// when one exists (`0` otherwise). Carries no message, path, or handle.
public struct IOError
{
    public IOErrorKind Kind;
    public int OsCode;
}

/// Whether `text` is absolute by the same lexical rules `CombinePath`
/// rejects a child with: a leading `/` or `\`, or a drive letter (`C:`).
internal bool IsAsciiLetterText(string oneChar)
{
    return oneChar == "A" || oneChar == "B" || oneChar == "C" || oneChar == "D"
        || oneChar == "E" || oneChar == "F" || oneChar == "G" || oneChar == "H"
        || oneChar == "I" || oneChar == "J" || oneChar == "K" || oneChar == "L"
        || oneChar == "M" || oneChar == "N" || oneChar == "O" || oneChar == "P"
        || oneChar == "Q" || oneChar == "R" || oneChar == "S" || oneChar == "T"
        || oneChar == "U" || oneChar == "V" || oneChar == "W" || oneChar == "X"
        || oneChar == "Y" || oneChar == "Z"
        || oneChar == "a" || oneChar == "b" || oneChar == "c" || oneChar == "d"
        || oneChar == "e" || oneChar == "f" || oneChar == "g" || oneChar == "h"
        || oneChar == "i" || oneChar == "j" || oneChar == "k" || oneChar == "l"
        || oneChar == "m" || oneChar == "n" || oneChar == "o" || oneChar == "p"
        || oneChar == "q" || oneChar == "r" || oneChar == "s" || oneChar == "t"
        || oneChar == "u" || oneChar == "v" || oneChar == "w" || oneChar == "x"
        || oneChar == "y" || oneChar == "z";
}

internal bool IsAbsolutePathText(string text)
{
    if (text.StartsWith("/")) { return true; }
    if (text.StartsWith("\\")) { return true; }
    if (text.Length < 2) { return false; }
    if (text.Substring(1, 1) != ":") { return false; }
    string first = text.Substring(0, 1);
    return IsAsciiLetterText(first);
}

/// A `\0` scalar as a one-character `string`, built without ASTER's `\0`
/// escape (unsupported by the lexer) so `CombinePath` can still detect an
/// embedded NUL using only official string operations.
internal string NulText()
{
    char nul = (char)0;
    return nul.ToString();
}

/// Lexically join `basePath` and a relative `childPath` with `/`. This does
/// not access the filesystem, canonicalize, resolve symlinks or dot segments,
/// or convert existing separators. Every filesystem operation validates its
/// own plain-string path independently.
public Result<string, IOError> CombinePath(string basePath, string childPath)
{
    if (basePath.Length == 0 || childPath.Length == 0)
    {
        return Result<string, IOError>.Error(IOError { Kind: IOErrorKind.InvalidPath, OsCode: 0 });
    }
    string nul = NulText();
    if (basePath.Contains(nul) || childPath.Contains(nul))
    {
        return Result<string, IOError>.Error(IOError { Kind: IOErrorKind.InvalidPath, OsCode: 0 });
    }
    if (IsAbsolutePathText(childPath))
    {
        return Result<string, IOError>.Error(IOError { Kind: IOErrorKind.InvalidPath, OsCode: 0 });
    }
    if (basePath.EndsWith("/") || basePath.EndsWith("\\"))
    {
        return Result<string, IOError>.Ok(basePath + childPath);
    }
    return Result<string, IOError>.Ok(basePath + "/" + childPath);
}

/// Read an entire UTF-8 text file managed internally by the host: opened,
/// read, and closed within this one call -- ASTER 1.0 exposes no owned file
/// handle. Preserves the file's bytes exactly (LF/CRLF, embedded NUL,
/// Unicode, leading/trailing whitespace); no trim, no newline normalization.
/// Only a regular file is accepted (`IOErrorKind.NotFile` for a directory or
/// other incompatible type). Invalid UTF-8 content is `IOErrorKind.
/// InvalidUtf8`, never a lossy or partial string. `path` is validated like
/// every other `aster.io` path argument (empty or embedded NUL is
/// `IOErrorKind.InvalidPath`); callers are not required to call `CombinePath`
/// first. Files larger than the internal 64 MiB limit are `IOErrorKind.
/// LimitExceeded`. This declaration's body is never executed: the real
/// behavior is the host intrinsic bound to this exact signature.
public Result<string, IOError> ReadAllText(string path)
{
    return Result<string, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

/// Create or truncate the file at `path` and write `content`'s UTF-8 bytes
/// in full, then flush and close -- managed internally by the host, never
/// exposing a handle. Never appends, never creates parent directories.
/// Returns the number of UTF-8 *bytes* written (not Unicode scalars) on
/// success. `IOErrorKind.NotFile` if `path` names an existing directory.
/// `content` byte length above the internal 64 MiB limit is `IOErrorKind.
/// LimitExceeded`, checked before the destination is touched. No atomicity
/// is promised: a failure after the file was created or truncated may leave
/// it empty, partially written, or created with no content. This
/// declaration's body is never executed: the real behavior is the host
/// intrinsic bound to this exact signature.
public Result<int, IOError> WriteAllText(string path, string content)
{
    return Result<int, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

/// Return the regular files immediately contained by `directory`. The host
/// opens, enumerates, and closes the directory within this one call; ASTER
/// never receives a directory handle. Results are complete paths relative to
/// the supplied argument, ordinally sorted, non-recursive, and exclude
/// directories, symlinks, and other non-regular entries. This declaration's
/// body is never executed: the host intrinsic owns the operation.
public Result<string[], IOError> ListFiles(string directory)
{
    return Result<string[], IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<string[], IOError> ReadAllLines(string path)
{
    switch (ReadAllText(path))
    {
        case Ok(text):
            if (text.Length == 0) { return Result<string[], IOError>.Ok([]); }
            string[] split = String.Split(text, "\n");
            int count = split.Length;
            if (count > 0 && split[count - 1].Length == 0) { count--; }
            List<string> lines = new List<string>();
            lines.EnsureCapacity(count);
            for (int index = 0; index < count; index++)
            {
                string line = split[index];
                if (line.EndsWith("\r")) { line = line.Substring(0, line.Length - 1); }
                lines.Add(line);
            }
            return Result<string[], IOError>.Ok(lines.ToArray());
        case Error(error):
            return Result<string[], IOError>.Error(error);
    }
}

public Result<int, IOError> WriteAllLines(string path, string[] lines)
{
    return WriteAllText(path, String.Join("\n", lines));
}

public Result<int, IOError> AppendAllText(string path, string text)
{
    return Result<int, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<string[], IOError> ListDirectories(string directory)
{
    return Result<string[], IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<bool, IOError> FileExists(string path)
{
    return Result<bool, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<bool, IOError> DirectoryExists(string path)
{
    return Result<bool, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<bool, IOError> CreateDirectory(string path)
{
    return Result<bool, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<bool, IOError> DeleteFile(string path)
{
    return Result<bool, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public Result<bool, IOError> DeleteDirectory(string path)
{
    return Result<bool, IOError>.Error(IOError { Kind: IOErrorKind.Other, OsCode: 0 });
}

public static class Path
{
    internal static int LastSeparator(string path)
    {
        int result = -1;
        switch (String.LastIndexOf(path, "/")) { case Some(index): result = index; case None: result = result; }
        switch (String.LastIndexOf(path, "\\")) { case Some(index): if (index > result) { result = index; } case None: result = result; }
        return result;
    }

    public static string GetFileName(string path)
    {
        int separator = LastSeparator(path);
        if (separator < 0) { return path; }
        return path.Substring(separator + 1);
    }

    public static string GetDirectoryName(string path)
    {
        int separator = LastSeparator(path);
        if (separator < 0) { return ""; }
        if (separator == 0) { return path.Substring(0, 1); }
        return path.Substring(0, separator);
    }

    public static string GetExtension(string path)
    {
        string name = GetFileName(path);
        int dot = -1;
        switch (String.LastIndexOf(name, ".")) { case Some(index): dot = index; case None: dot = dot; }
        if (dot <= 0) { return ""; }
        return name.Substring(dot);
    }

    public static string ChangeExtension(string path, string extension)
    {
        string current = GetExtension(path);
        string prefix = current.Length == 0 ? path : path.Substring(0, path.Length - current.Length);
        if (extension.Length == 0) { return prefix; }
        if (extension.StartsWith(".")) { return prefix + extension; }
        return prefix + "." + extension;
    }
}

