namespace aster.random;

using aster.math;

internal void __RandomInvalidRange() {}
internal ulong __RandomMix(ulong value) { return value; }
internal ulong __RandomEntropySeed() { return 0UL; }

/// Explicitly seeded SplitMix64 generator. The sequence is deterministic
/// across ASTER targets and is not suitable for cryptographic use.
public class Random
{
    private ulong state;

    public Random(ulong seed) { state = seed; }

    /// Creates a generator seeded from operating-system entropy. Each call reads a
    /// fresh 64-bit sample from the OS (two samples can in principle be equal, with
    /// negligible probability). The seed is read
    /// once here; later numbers cost the same as for any explicitly seeded generator.
    /// This is a host operation: it is rejected in `Task`/`Parallel` worker bodies,
    /// which receive explicit seeds instead.
    public static Random FromEntropy() { return new Random(__RandomEntropySeed()); }

    public ulong NextULong()
    {
        state = state + 11400714819323198485UL;
        return __RandomMix(state);
    }

    public uint NextUInt()
    {
        state = state + 11400714819323198485UL;
        return (uint)(__RandomMix(state) / 4294967296UL);
    }
    public bool NextBool() { return NextULong() / 9223372036854775808UL != 0UL; }

    public int NextInt(int minInclusive, int maxExclusive)
    {
        if (minInclusive >= maxExclusive) { __RandomInvalidRange(); return minInclusive; }
        ulong span = (ulong)((long)maxExclusive - (long)minInclusive);
        ulong threshold = ((18446744073709551615UL % span) + 1UL) % span;
        while (true)
        {
            ulong sample = NextULong();
            if (sample >= threshold)
            {
                return (int)((long)minInclusive + (long)(sample % span));
            }
        }
        return minInclusive;
    }

    public long NextLong(long minInclusive, long maxExclusive)
    {
        if (minInclusive >= maxExclusive) { __RandomInvalidRange(); return minInclusive; }
        ulong span = (ulong)maxExclusive - (ulong)minInclusive;
        ulong threshold = ((18446744073709551615UL % span) + 1UL) % span;
        while (true)
        {
            ulong sample = NextULong();
            if (sample >= threshold) { return (long)((ulong)minInclusive + (sample % span)); }
        }
        return minInclusive;
    }

    public float NextFloat()
    {
        return (float)(NextUInt() / 256u) / 16777216.0f;
    }

    public double NextDouble()
    {
        return (double)(NextULong() / 2048UL) / 9007199254740992.0d;
    }

    /// A float in `[minInclusive, maxExclusive)`. Both bounds must be finite with
    /// `minInclusive < maxExclusive`, otherwise it is a controlled runtime error.
    /// Draws exactly one `NextUInt()`. The arithmetic runs in `double`, so even
    /// the widest float interval cannot overflow; when rounding to `float` would
    /// reach the exclusive bound the result is `minInclusive`, so the bound is
    /// never returned.
    public float NextFloat(float minInclusive, float maxExclusive)
    {
        if (!Math.IsFinite(minInclusive) || !Math.IsFinite(maxExclusive) || minInclusive >= maxExclusive)
        {
            __RandomInvalidRange();
            return minInclusive;
        }
        double unit = (double)(NextUInt() / 256u) / 16777216.0d;
        double low = (double)minInclusive;
        float value = (float)(low + unit * ((double)maxExclusive - low));
        if (value >= maxExclusive) { return minInclusive; }
        return value;
    }

    /// A double in `[minInclusive, maxExclusive)`. Both bounds must be finite with
    /// `minInclusive < maxExclusive`, otherwise it is a controlled runtime error.
    /// Draws exactly one `NextULong()`. When `maxExclusive - minInclusive` would
    /// overflow, the span is taken in halves so the result stays finite. When
    /// rounding would reach the exclusive bound the result is `minInclusive`, so
    /// the bound is never returned and no redraw loop exists.
    public double NextDouble(double minInclusive, double maxExclusive)
    {
        if (!Math.IsFinite(minInclusive) || !Math.IsFinite(maxExclusive) || minInclusive >= maxExclusive)
        {
            __RandomInvalidRange();
            return minInclusive;
        }
        double unit = (double)(NextULong() / 2048UL) / 9007199254740992.0d;
        double span = maxExclusive - minInclusive;
        double value;
        if (Math.IsInfinity(span))
        {
            double part = unit * (maxExclusive * 0.5d - minInclusive * 0.5d);
            value = (minInclusive + part) + part;
        }
        else
        {
            value = minInclusive + unit * span;
        }
        if (value >= maxExclusive) { return minInclusive; }
        return value;
    }
}
