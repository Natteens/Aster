namespace aster.math;

internal void __AbsIntOverflow()
{
}

internal void __AbsLongOverflow()
{
}

internal void __ClampInvalidRange()
{
}

internal float __MathUnaryFloat(float value, int operation)
{
    return value;
}

internal double __MathUnaryDouble(double value, int operation)
{
    return value;
}

internal float __MathPowFloat(float value, float exponent)
{
    return value;
}

internal double __MathPowDouble(double value, double exponent)
{
    return value;
}

public static class Math
{
    public static float Sqrt(float value) { return __MathUnaryFloat(value, 0); }
    public static double Sqrt(double value) { return __MathUnaryDouble(value, 0); }
    public static float Floor(float value) { return __MathUnaryFloat(value, 1); }
    public static double Floor(double value) { return __MathUnaryDouble(value, 1); }
    public static float Ceil(float value) { return __MathUnaryFloat(value, 2); }
    public static double Ceil(double value) { return __MathUnaryDouble(value, 2); }
    public static float Round(float value) { return __MathUnaryFloat(value, 3); }
    public static double Round(double value) { return __MathUnaryDouble(value, 3); }
    public static float Sin(float value) { return __MathUnaryFloat(value, 4); }
    public static double Sin(double value) { return __MathUnaryDouble(value, 4); }
    public static float Cos(float value) { return __MathUnaryFloat(value, 5); }
    public static double Cos(double value) { return __MathUnaryDouble(value, 5); }
    public static float Tan(float value) { return __MathUnaryFloat(value, 6); }
    public static double Tan(double value) { return __MathUnaryDouble(value, 6); }
    public static float Pow(float value, float exponent) { return __MathPowFloat(value, exponent); }
    public static double Pow(double value, double exponent) { return __MathPowDouble(value, exponent); }

    public static int Abs(int value)
    {
        if (value == -2147483647 - 1)
        {
            __AbsIntOverflow();
            return 0;
        }

        if (value < 0)
        {
            return -value;
        }

        return value;
    }

    public static long Abs(long value)
    {
        if (value == -9223372036854775807L - 1L)
        {
            __AbsLongOverflow();
            return 0L;
        }

        if (value < 0L)
        {
            return -value;
        }

        return value;
    }

    public static int Min(int left, int right)
    {
        return left < right ? left : right;
    }

    public static long Min(long left, long right)
    {
        return left < right ? left : right;
    }

    public static float Min(float left, float right)
    {
        if (left != left)
        {
            return left;
        }

        if (right != right)
        {
            return right;
        }

        return left < right ? left : right;
    }

    public static double Min(double left, double right)
    {
        if (left != left)
        {
            return left;
        }

        if (right != right)
        {
            return right;
        }

        return left < right ? left : right;
    }

    public static int Max(int left, int right)
    {
        return left > right ? left : right;
    }

    public static long Max(long left, long right)
    {
        return left > right ? left : right;
    }

    public static float Max(float left, float right)
    {
        if (left != left)
        {
            return left;
        }

        if (right != right)
        {
            return right;
        }

        return left > right ? left : right;
    }

    public static double Max(double left, double right)
    {
        if (left != left)
        {
            return left;
        }

        if (right != right)
        {
            return right;
        }

        return left > right ? left : right;
    }

    public static int Clamp(int value, int min, int max)
    {
        if (min > max)
        {
            __ClampInvalidRange();
            return value;
        }

        return Max(min, Min(value, max));
    }

    public static long Clamp(long value, long min, long max)
    {
        if (min > max)
        {
            __ClampInvalidRange();
            return value;
        }

        return Max(min, Min(value, max));
    }

    public static float Clamp(float value, float min, float max)
    {
        if (value != value)
        {
            return value;
        }

        if (min != min)
        {
            return min;
        }

        if (max != max)
        {
            return max;
        }

        if (min > max)
        {
            __ClampInvalidRange();
            return value;
        }

        return Max(min, Min(value, max));
    }

    public static double Clamp(double value, double min, double max)
    {
        if (value != value)
        {
            return value;
        }

        if (min != min)
        {
            return min;
        }

        if (max != max)
        {
            return max;
        }

        if (min > max)
        {
            __ClampInvalidRange();
            return value;
        }

        return Max(min, Min(value, max));
    }
}
