namespace aster.text;

using aster.core;

internal string __Trim(string value)
{
    return "";
}

internal string __Replace(string value, string oldValue, string newValue)
{
    return "";
}

internal string[] __Split(string value, string separator)
{
    return [value];
}

internal int __LastIndexOf(string value, string pattern) { return -1; }
internal string __TrimStart(string value) { return value; }
internal string __TrimEnd(string value) { return value; }
internal string __JoinArray(string separator, string[] values) { return ""; }
internal string __ConcatArray(string[] values) { return ""; }
internal string __Repeat(string value, int count) { return ""; }
internal char[] __ToChars(string value) { return []; }
internal string __FromChars(char[] values) { return ""; }

public static class String
{
    public static bool IsEmpty(string value)
    {
        return value.Length == 0;
    }

    public static bool Contains(string value, string pattern)
    {
        return value.Contains(pattern);
    }

    public static bool StartsWith(string value, string pattern)
    {
        return value.StartsWith(pattern);
    }

    public static bool EndsWith(string value, string pattern)
    {
        return value.EndsWith(pattern);
    }

    public static Option<int> IndexOf(string value, string pattern)
    {
        int index = value.IndexOf(pattern);
        return index < 0 ? Option<int>.None : Option<int>.Some(index);
    }

    public static Option<int> LastIndexOf(string value, string pattern)
    {
        int index = __LastIndexOf(value, pattern);
        return index < 0 ? Option<int>.None : Option<int>.Some(index);
    }

    public static string Substring(string value, int start)
    {
        return value.Substring(start);
    }

    public static string Substring(string value, int start, int length)
    {
        return value.Substring(start, length);
    }

    public static string Trim(string value)
    {
        return __Trim(value);
    }

    public static string TrimStart(string value) { return __TrimStart(value); }
    public static string TrimEnd(string value) { return __TrimEnd(value); }

    public static string Replace(string value, string oldValue, string newValue)
    {
        return __Replace(value, oldValue, newValue);
    }

    public static string[] Split(string value, string separator)
    {
        return __Split(value, separator);
    }


    public static string Join(string separator, string[] values)
    {
        return __JoinArray(separator, values);
    }

    public static string Concat(string[] values) { return __ConcatArray(values); }
    public static string Repeat(string value, int count) { return __Repeat(value, count); }
    public static char[] ToChars(string value) { return __ToChars(value); }
    public static string FromChars(char[] values) { return __FromChars(values); }
}
